[NAME]
name=deps

[VERSION]
version=2.4

[RELEASE]
release=0.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=This package is designed to automatically installation BuildRequires dependencies and search/check
1=Requires/Recommends packages from the .spec-files. Go to the directory that contains the spec file and give the command "deps"
2=...
3=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Parser script for the automatic installation of BuildRequires from .spec files.

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/deps

[LICENSE]
license=GPL-3.0-or-later

[DEPS]
deps=

[META]
meta=0

[NOARCH]
noarch=1

[DEB]
deb=0

[FILES]
0=/usr/bin/deps
1=/usr/share/doc/deps/

[AFTERINSTALL]
0=mkdir -p ~/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}

[URL32]
url32=https://github.com/AKotov-dev/deps

[PROGRAMNAME]
programname=deps

[DEVTOOL]
devtool=Shell

[TOOLVERSION]
toolversion=unknown

[INFO]
0=The script is intended for automatic installation BuildRequires
1=dependencies and search/check Requires/Recommends packages from the *.spec-file
2=
3=
4=v2.4
5=+ Path support with spaces (`"$spec"`)
6=+ Filtering duplicate dependencies (`| sort -u`)
7=
8=v2.3-4
9=+ spec file name in command line
10=+ use "dnf" in Search/Check Requires and Recommends dependencies
11=
12=v2.3-3
13=+ Search/Check Requires and Recommends dependencies
14=
15=v2.3-2
16=+ mkdir -p ~/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
